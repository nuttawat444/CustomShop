
@model WarehouseListingViewModel

<div class="dash-field">
    <label asp-for="PublishNow">การแสดงบนหน้า Product</label>
    <select asp-for="PublishNow">
        <option value="false">รอ Admin อนุมัติ</option>
        <option value="true">เปิดขายทันที</option>
    </select>
</div>
<div class="dash-field">
    <label asp-for="Price">ราคาขาย (บาท)</label>
    <input asp-for="Price" type="number" min="0" max="999999999" step="0.01" aria-describedby="@Html.IdFor(model => model.Price)-hint" />
    <small id="@Html.IdFor(model => model.Price)-hint">ต้องใส่ราคามากกว่า 0 บาทเมื่อเปิดขายทันที</small>
</div>
