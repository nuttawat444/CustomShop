@model MemberProfileViewModel
@using System.Globalization
@using System.Security.Claims
@{
    Layout = "_LayoutUser";
    ViewData["Title"] = "บัญชีของฉัน";

    var displayName = User.Identity?.Name ?? "สมาชิก";
    var email = User.FindFirstValue(ClaimTypes.Email) ?? "ไม่พบอีเมล";
    var role = User.FindFirstValue(ClaimTypes.Role) ?? "Member";
    var initial = StringInfo.GetNextTextElement(displayName);
}

<section class="dash member-profile">
    <h1>บัญชีของฉัน</h1>

    <section class="dash-panel member-profile-identity" aria-labelledby="member-name">
        <span class="member-profile-avatar" aria-hidden="true">@initial</span>
        <div class="member-profile-details">
            <h2 id="member-name">@displayName</h2>
            <p class="dash-subtitle">@email <span class="dash-status">@role</span></p>
        </div>
        <div class="dash-actions">
            @if (ShopAccess.DashboardFor(User) is { } dashboard)
            {
                <a class="dash-button" asp-controller="@dashboard.Controller" asp-action="Index">@dashboard.Label Dashboard</a>
            }
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button class="dash-button" type="submit">ออกจากระบบ</button>
            </form>
        </div>
    </section>

    @if (ShopAccess.CanBuy(User))
    {
        <nav class="member-profile-shortcuts" aria-label="บริการสำหรับสมาชิก">
            <a class="dash-button" asp-controller="Cart" asp-action="History">ประวัติการสั่งซื้อ</a>
            <a class="dash-button" asp-controller="Cart" asp-action="Quotes">คำขอประเมินราคา</a>
            <a class="dash-button is-primary" asp-controller="Home" asp-action="Product">เลือกซื้อสินค้า</a>
        </nav>

        <section class="dash-panel member-profile-offers" aria-labelledby="member-offers">
            <header>
                <h2 id="member-offers">โค้ดส่วนลดของฉัน</h2>
                <p class="dash-subtitle">คัดลอกโค้ดไปใส่ในตะกร้า ใช้ได้หนึ่งโค้ดต่อคำสั่งซื้อ และโค้ดสมาชิกแต่ละรายการใช้ได้หนึ่งครั้งต่อบัญชี</p>
            </header>

            <p class="member-profile-copy-status" data-coupon-copy-status role="status"></p>
            <div class="member-profile-coupons">
                @foreach (var coupon in Model.Coupons)
                {
                    var category = coupon.Category switch
                    {
                        "*" => "สินค้าทุกหมวด",
                        "helmet" => "หมวกกันน็อก",
                        "parts" => "อะไหล่และอุปกรณ์แต่ง",
                        "exhaust" => "สินค้าหมวด Exhaust",
                        _ => coupon.Category
                    };
                    <article class="member-profile-coupon">
                        <div>
                            <strong class="member-profile-discount">ลด @coupon.Percent.ToString("0.##")%</strong>
                            <p class="dash-subtitle">@category</p>
                        </div>
                        <code>@coupon.Code</code>
                        @if (coupon.Used)
                        {
                            <span class="dash-status">ใช้แล้ว</span>
                        }
                        else
                        {
                            <button class="dash-button" type="button" data-copy-coupon="@coupon.Code"
                                    aria-label="คัดลอกโค้ด @coupon.Code">คัดลอก</button>
                        }
                    </article>
                }
            </div>

            <section class="member-profile-saved" aria-labelledby="member-saved-offers">
                <h3 id="member-saved-offers">โค้ดที่บันทึกไว้</h3>
                @if (TempData["OfferMessage"] is string message)
                {
                    <p class="dash-notice" role="status">@message</p>
                }
                <form asp-controller="Account" asp-action="SaveOffer" method="post" class="member-profile-save">
                    <label class="dash-field" asp-for="Code">โค้ดจากหน้าโปรโมชัน
                        <input asp-for="Code" maxlength="40" required />
                    </label>
                    <button class="dash-button" type="submit">บันทึกโค้ด</button>
                </form>
                @if (Model.SavedOffers.Count == 0)
                {
                    <p class="dash-subtitle">ยังไม่มีโค้ดอื่นที่บันทึกไว้</p>
                }
                @foreach (var offer in Model.SavedOffers)
                {
                    <article class="dash-task">
                        <div><strong>@offer.Code</strong><p class="dash-subtitle">@offer.Description</p></div>
                        @if (offer.PackageId.HasValue)
                        {
                            <form asp-controller="Cart" asp-action="RequestQuote" method="post">
                                <input type="hidden" name="id" value="@offer.PackageId" />
                                <button class="dash-button" type="submit">ขอประเมินราคา</button>
                            </form>
                        }
                        else
                        {
                            <a class="dash-button" asp-controller="Cart" asp-action="Index">ใช้โค้ดที่ตะกร้า</a>
                        }
                    </article>
                }
            </section>
        </section>
    }
</section>

@section Scripts {
    <script src="~/js/member-profile.js" asp-append-version="true"></script>
}
