@{
    Layout = null;
    ViewData["Title"] = "สมัครสมาชิก - CustomShop";
}
@model RegisterViewModel
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>สมัครสมาชิก - CustomShop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">

    <partial name="_ThemeAssets" />
    <style>
        :root {
            --brand-dark: #161513;
            --brand-accent: #ff5a1f;
            --brand-accent-hover: #e04b15;
            --surface-bg: var(--theme-surface);
            --input-bg: var(--theme-raised);
            --border-color: var(--theme-control-border);
            --text-main: var(--theme-ink);
            --text-muted: var(--theme-muted);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            height: 100%;
            font-family: 'Work Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--brand-dark);
            color: var(--text-main);
        }

        .auth-container {
            display: flex;
            min-height: 100vh;
            width: 100%;
        }

        /* ===== LEFT BRAND PANEL ===== */
        .brand-panel {
            flex: 1.1;
            position: relative;
            background:
                linear-gradient(135deg, rgba(16, 14, 12, 0.95) 0%, rgba(26, 23, 20, 0.85) 60%, rgba(16, 14, 12, 0.92) 100%),
                url("https://images.unsplash.com/photo-1558981806-ec527fa84c39?auto=format&fit=crop&w=1400&q=80") center / cover no-repeat;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: clamp(32px, 5vw, 56px);
            color: #ffffff;
            overflow: hidden;
        }

        .brand-panel::before {
            content: "";
            position: absolute;
            top: -20%;
            left: -20%;
            width: 70%;
            height: 70%;
            background: radial-gradient(circle, rgba(255, 90, 31, 0.18) 0%, transparent 70%);
            filter: blur(50px);
            pointer-events: none;
        }

        .brand-panel-top {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand-logo {
            font-family: 'Fraunces', serif;
            font-size: 1.8rem;
            font-weight: 700;
            color: #ffffff;
            text-decoration: none;
            letter-spacing: 0.3px;
            display: inline-flex;
            align-items: baseline;
            gap: 2px;
        }

        .brand-logo span.accent-dot {
            color: #ff9a73;
            font-size: 2rem;
            line-height: 0;
        }

        .btn-home-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.18);
            color: #f0ebe4;
            text-decoration: none;
            font-size: 0.86rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .btn-home-link:hover {
            background: rgba(255, 255, 255, 0.2);
            color: #ffffff;
            transform: translateX(-2px);
        }

        .brand-panel-body {
            position: relative;
            z-index: 2;
            max-width: 520px;
            margin: 40px 0;
        }

        .brand-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            border-radius: 999px;
            background: rgba(255, 90, 31, 0.2);
            border: 1px solid rgba(255, 90, 31, 0.35);
            color: #ff9a73;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-bottom: 20px;
        }

        .brand-title {
            font-family: 'Fraunces', serif;
            font-size: clamp(2rem, 4vw, 3rem);
            font-weight: 600;
            line-height: 1.15;
            color: #ffffff;
            margin-bottom: 18px;
        }

        .brand-desc {
            color: #cfc6bc;
            font-size: 1rem;
            line-height: 1.7;
            margin-bottom: 30px;
        }

        .brand-features {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .brand-features li {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.92rem;
            color: #eae5de;
        }

        .brand-features li .check-icon {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: rgba(255, 90, 31, 0.25);
            color: #ff9a73;
            display: grid;
            place-items: center;
            font-size: 0.75rem;
            font-weight: 700;
            flex-shrink: 0;
        }

        .brand-panel-bottom {
            position: relative;
            z-index: 2;
            color: var(--theme-muted);
            font-size: 0.82rem;
        }

        /* ===== RIGHT FORM PANEL ===== */
        .form-panel {
            flex: 0.9;
            background: var(--theme-surface);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: clamp(24px, 4vw, 48px) clamp(20px, 3vw, 48px);
            position: relative;
            overflow-y: auto;
        }

        .form-wrapper {
            width: 100%;
            max-width: 420px;
        }

        .form-header {
            margin-bottom: 28px;
        }

        .form-header h1 {
            font-family: 'Fraunces', serif;
            font-size: 2rem;
            font-weight: 600;
            color: var(--theme-ink);
            margin-bottom: 8px;
            line-height: 1.15;
        }

        .form-header p {
            color: var(--text-muted);
            font-size: 0.92rem;
        }

        /* Status & Alert Messages */
        .alert-message {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 16px;
            border-radius: 14px;
            font-size: 0.9rem;
            margin-bottom: 20px;
            line-height: 1.5;
        }

        .alert-danger {
            background: var(--theme-error-bg);
            border: 1px solid var(--theme-line);
            color: var(--theme-error);
        }

        .validation-summary-errors {
            background: var(--theme-error-bg);
            border: 1px solid var(--theme-line);
            color: var(--theme-error);
            border-radius: 14px;
            padding: 12px 16px;
            font-size: 0.88rem;
            margin-bottom: 18px;
        }

        .validation-summary-errors ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        /* Form Controls */
        .form-group {
            margin-bottom: 16px;
        }

        .form-label {
            display: block;
            margin-bottom: 6px;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--theme-ink);
        }

        .input-group {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-icon {
            position: absolute;
            left: 14px;
            color: var(--theme-muted);
            pointer-events: none;
            display: grid;
            place-items: center;
        }

        .input-icon svg {
            width: 18px;
            height: 18px;
        }

        .form-control {
            width: 100%;
            padding: 12px 14px 12px 42px;
            border-radius: 12px;
            border: 1.5px solid var(--border-color);
            background: var(--input-bg);
            color: var(--text-main);
            font-size: 0.93rem;
            font-family: inherit;
            outline: none;
            transition: all 0.2s ease;
        }

        .form-control:focus {
            background: var(--theme-surface);
            border-color: var(--brand-accent);
            box-shadow: 0 0 0 4px rgba(255, 90, 31, 0.12);
        }

        .form-control::placeholder {
            color: var(--theme-muted);
        }

        /* Password with toggle button */
        .input-group-password .form-control {
            padding-right: 46px;
        }

        .btn-toggle-password {
            position: absolute;
            right: 12px;
            background: none;
            border: none;
            color: var(--theme-muted);
            cursor: pointer;
            padding: 4px;
            border-radius: 8px;
            display: grid;
            place-items: center;
            transition: color 0.2s;
        }

        .btn-toggle-password:hover {
            color: var(--text-main);
        }

        .btn-toggle-password svg {
            width: 19px;
            height: 19px;
        }

        .field-error {
            display: block;
            margin-top: 4px;
            font-size: 0.8rem;
            color: var(--theme-error);
            font-weight: 500;
        }

        /* Row for two columns */
        .form-row {
            display: flex;
            gap: 14px;
        }

        .form-row .form-group {
            flex: 1;
        }

        /* Divider */
        .form-divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 20px 0;
        }

        .form-divider hr {
            flex: 1;
            border: none;
            border-top: 1px solid #e8e3dc;
        }

        .form-divider span {
            color: var(--theme-muted);
            font-size: 0.8rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            white-space: nowrap;
        }

        /* Submit Button */
        .btn-submit {
            width: 100%;
            padding: 13px 24px;
            border-radius: 999px;
            border: none;
            background: var(--theme-accent-bg);
            color: #ffffff;
            font-size: 1rem;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: transform 0.2s, background-color 0.2s, box-shadow 0.2s;
            box-shadow: 0 8px 22px rgba(255, 90, 31, 0.32);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-submit:hover {
            background: var(--theme-accent-hover);
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(255, 90, 31, 0.42);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

        .form-footer {
            margin-top: 22px;
            text-align: center;
            font-size: 0.92rem;
            color: var(--text-muted);
        }

        .link-login {
            color: var(--theme-accent);
            font-weight: 600;
            text-decoration: none;
            margin-left: 4px;
        }

        .link-login:hover {
            text-decoration: underline;
        }

        /* Password strength meter */
        .password-strength {
            margin-top: 6px;
            height: 4px;
            border-radius: 999px;
            background: var(--theme-raised);
            overflow: hidden;
        }

        .password-strength-bar {
            height: 100%;
            border-radius: 999px;
            width: 0;
            transition: width 0.3s ease, background 0.3s ease;
        }

        .password-strength-text {
            margin-top: 4px;
            font-size: 0.75rem;
            font-weight: 500;
            color: var(--theme-muted);
        }

        /* Terms text */
        .terms-text {
            margin-top: 16px;
            font-size: 0.78rem;
            color: var(--theme-muted);
            text-align: center;
            line-height: 1.6;
        }

        .terms-text a {
            color: var(--theme-accent);
            text-decoration: none;
            font-weight: 500;
        }

        .terms-text a:hover {
            text-decoration: underline;
        }

        /* ===== RESPONSIVE ===== */
        @@media (max-width: 900px) {
            .auth-container {
                flex-direction: column;
            }

            .brand-panel {
                flex: none;
                min-height: 220px;
                padding: 24px 20px;
            }

            .brand-panel-body {
                margin: 16px 0;
            }

            .brand-desc, .brand-features {
                display: none;
            }

            .form-panel {
                padding: 32px 20px;
            }

            .form-row {
                flex-direction: column;
                gap: 0;
            }
        }
    </style>
</head>
<body>
    <div class="auth-container">

        <!-- LEFT BRAND PANEL -->
        <div class="brand-panel">
            <div class="brand-panel-top">
                <a class="brand-logo" asp-controller="Home" asp-action="Index">
                    Custom<span class="accent-dot">.</span>Shop
                </a>
                <a class="btn-home-link" asp-controller="Home" asp-action="Index">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                    </svg>
                    กลับสู่หน้าร้าน
                </a>
            </div>

            <div class="brand-panel-body">
                <div class="brand-badge">🏍️ VINTAGE CUSTOM GARAGE</div>
                <h2 class="brand-title">ร่วมเป็นส่วนหนึ่ง<br/>ของครอบครัว CustomShop</h2>
                <p class="brand-desc">
                    สมัครสมาชิกเพื่อสั่งซื้ออะไหล่แต่ง จองบริการคัสตอม
                    ตรวจสอบสถานะงาน และรับสิทธิพิเศษสำหรับสมาชิก
                </p>
                <ul class="brand-features">
                    <li>
                        <span class="check-icon">✓</span>
                        ติดตามสถานะงานคัสตอมแบบ Real-time
                    </li>
                    <li>
                        <span class="check-icon">✓</span>
                        สั่งซื้ออะไหล่ Handcrafted คุณภาพสูง
                    </li>
                    <li>
                        <span class="check-icon">✓</span>
                        รับส่วนลดสมาชิกและโปรโมชั่นพิเศษ
                    </li>
                    <li>
                        <span class="check-icon">✓</span>
                        เข้าถึงแกลเลอรี่ผลงาน Cafe Racer, Bobber, Scrambler
                    </li>
                </ul>
            </div>

            <div class="brand-panel-bottom">
                &copy; 2569 CustomShop. All rights reserved.
            </div>
        </div>

        <!-- RIGHT FORM PANEL -->
        <div class="form-panel">
            <div class="form-wrapper">
                <div class="form-header">
                    <h1>สมัครสมาชิก</h1>
                    <p>กรอกข้อมูลด้านล่างเพื่อสร้างบัญชีผู้ใช้ใหม่</p>
                </div>

                @if (TempData["StatusMessage"] is string statusMsg)
                {
                    <div class="alert-message alert-danger" role="status">
                        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/>
                        </svg>
                        <span>@statusMsg</span>
                    </div>
                }

                <form asp-controller="Account" asp-action="Register" method="post" autocomplete="on">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

                    <!-- Name & Username -->
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label" asp-for="Name">ชื่อ-นามสกุล</label>
                            <div class="input-group">
                                <span class="input-icon">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                    </svg>
                                </span>
                                <input class="form-control" asp-for="Name" type="text" placeholder="ชื่อ นามสกุล" required autocomplete="name" />
                            </div>
                            <span class="field-error" asp-validation-for="Name"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label" asp-for="Username">ชื่อผู้ใช้</label>
                            <div class="input-group">
                                <span class="input-icon">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.121 17.804A13.937 13.937 0 0112 16c2.5 0 4.847.655 6.879 1.804M15 10a3 3 0 11-6 0 3 3 0 016 0zm6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                    </svg>
                                </span>
                                <input class="form-control" asp-for="Username" type="text" placeholder="username" required autocomplete="username" />
                            </div>
                            <span class="field-error" asp-validation-for="Username"></span>
                        </div>
                    </div>

                    <!-- Email -->
                    <div class="form-group">
                        <label class="form-label" asp-for="EmailUser">อีเมล (Email)</label>
                        <div class="input-group">
                            <span class="input-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/>
                                </svg>
                            </span>
                            <input class="form-control" asp-for="EmailUser" type="email" placeholder="example@customshop.com" required autocomplete="email" />
                        </div>
                        <span class="field-error" asp-validation-for="EmailUser"></span>
                    </div>

                    <!-- Tel -->
                    <div class="form-group">
                        <label class="form-label" asp-for="Tel">เบอร์โทรศัพท์</label>
                        <div class="input-group">
                            <span class="input-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                </svg>
                            </span>
                            <input class="form-control" asp-for="Tel" type="tel" placeholder="08X-XXX-XXXX" required autocomplete="tel" />
                        </div>
                        <span class="field-error" asp-validation-for="Tel"></span>
                    </div>

                    <div class="form-divider">
                        <hr /><span>ตั้งรหัสผ่าน</span><hr />
                    </div>

                    <!-- Password -->
                    <div class="form-group">
                        <label class="form-label" asp-for="Password">รหัสผ่าน</label>
                        <div class="input-group input-group-password">
                            <span class="input-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                                </svg>
                            </span>
                            <input id="passwordInput" class="form-control" asp-for="Password" type="password" placeholder="••••••••" required autocomplete="new-password" />
                            <button type="button" class="btn-toggle-password" id="togglePasswordBtn" aria-label="แสดงหรือซ่อนรหัสผ่าน">
                                <svg id="eyeIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                            </button>
                        </div>
                        <div class="password-strength">
                            <div class="password-strength-bar" id="strengthBar"></div>
                        </div>
                        <div class="password-strength-text" id="strengthText"></div>
                        <span class="field-error" asp-validation-for="Password"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="form-group">
                        <label class="form-label" asp-for="ConfirmPassword">ยืนยันรหัสผ่าน</label>
                        <div class="input-group input-group-password">
                            <span class="input-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                                </svg>
                            </span>
                            <input id="confirmPasswordInput" class="form-control" asp-for="ConfirmPassword" type="password" placeholder="••••••••" required autocomplete="new-password" />
                            <button type="button" class="btn-toggle-password" id="toggleConfirmBtn" aria-label="แสดงหรือซ่อนรหัสผ่าน">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                            </button>
                        </div>
                        <span class="field-error" asp-validation-for="ConfirmPassword"></span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn-submit">
                        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                        </svg>
                        สมัครสมาชิก
                    </button>

                    <!-- Footer Link to Login -->
                    <div class="form-footer">
                        <span>มีบัญชีอยู่แล้ว?</span>
                        <a class="link-login" asp-controller="Account" asp-action="Login">
                            เข้าสู่ระบบที่นี่
                        </a>
                    </div>

                    <p class="terms-text">
                        การสมัครสมาชิกหมายความว่าคุณยอมรับ
                        <a href="#">ข้อตกลงการใช้งาน</a> และ
                        <a href="#">นโยบายความเป็นส่วนตัว</a> ของเรา
                    </p>
                </form>
            </div>
        </div>

    </div>

    <script>
        // Toggle password visibility
        function setupToggle(btnId, inputId) {
            var btn = document.getElementById(btnId);
            var input = document.getElementById(inputId);
            if (btn && input) {
                btn.addEventListener('click', function () {
                    var isPassword = input.getAttribute('type') === 'password';
                    input.setAttribute('type', isPassword ? 'text' : 'password');
                    btn.setAttribute('aria-label', isPassword ? 'ซ่อนรหัสผ่าน' : 'แสดงรหัสผ่าน');
                    btn.style.color = isPassword ? 'var(--brand-accent)' : '#9c9186';
                });
            }
        }
        setupToggle('togglePasswordBtn', 'passwordInput');
        setupToggle('toggleConfirmBtn', 'confirmPasswordInput');

        // Password strength meter
        var passwordInput = document.getElementById('passwordInput');
        var strengthBar = document.getElementById('strengthBar');
        var strengthText = document.getElementById('strengthText');
        if (passwordInput && strengthBar && strengthText) {
            passwordInput.addEventListener('input', function () {
                var val = passwordInput.value;
                var score = 0;
                if (val.length >= 6) score++;
                if (val.length >= 10) score++;
                if (/[A-Z]/.test(val)) score++;
                if (/[0-9]/.test(val)) score++;
                if (/[^A-Za-z0-9]/.test(val)) score++;

                var widths = ['0%', '20%', '40%', '60%', '80%', '100%'];
                var colors = ['#e8e3dc', '#ef4444', '#f59e0b', '#eab308', '#22c55e', '#16a34a'];
                var labels = ['', 'อ่อนมาก', 'อ่อน', 'ปานกลาง', 'ดี', 'แข็งแรง'];

                strengthBar.style.width = widths[score];
                strengthBar.style.background = colors[score];
                strengthText.textContent = labels[score];
                strengthText.style.color = colors[score];
            });
        }
    </script>
</body>
</html>
