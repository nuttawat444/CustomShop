@{
    Layout = null;
    ViewData["Title"] = "ลืมรหัสผ่าน - CustomShop";
}
@model ForgotPasswordViewModel
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ลืมรหัสผ่าน / ตั้งรหัสผ่านใหม่ - CustomShop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">

    <partial name="_ThemeAssets" />
    <style>
        :root {
            --brand-dark: #161513;
            --brand-accent: #ff5a1f;
            --brand-accent-hover: #e04b15;
            --surface-bg: var(--theme-surface);
            --input-bg: var(--theme-raised);
            --border-color: var(--theme-control-border);
            --text-main: var(--theme-ink);
            --text-muted: var(--theme-muted);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html, body {
            height: 100%;
            font-family: 'Work Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--brand-dark);
            color: var(--text-main);
        }

        .auth-container {
            display: flex;
            min-height: 100vh;
            width: 100%;
        }

        /* ===== LEFT BRAND PANEL ===== */
        .brand-panel {
            flex: 1.1;
            position: relative;
            background:
                linear-gradient(135deg, rgba(16, 14, 12, 0.95) 0%, rgba(26, 23, 20, 0.85) 60%, rgba(16, 14, 12, 0.92) 100%),
                url("https://images.unsplash.com/photo-1558981359-219d6364c9c8?auto=format&fit=crop&w=1400&q=80") center / cover no-repeat;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: clamp(32px, 5vw, 56px);
            color: #ffffff;
            overflow: hidden;
        }

        .brand-panel::before {
            content: "";
            position: absolute;
            top: -20%;
            left: -20%;
            width: 70%;
            height: 70%;
            background: radial-gradient(circle, rgba(255, 90, 31, 0.18) 0%, transparent 70%);
            filter: blur(50px);
            pointer-events: none;
        }

        .brand-panel-top {
            position: relative;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand-logo {
            font-family: 'Fraunces', serif;
            font-size: 1.8rem;
            font-weight: 700;
            color: #ffffff;
            text-decoration: none;
            letter-spacing: 0.3px;
            display: inline-flex;
            align-items: baseline;
            gap: 2px;
        }

        .brand-logo span.accent-dot {
            color: #ff9a73;
            font-size: 2rem;
            line-height: 0;
        }

        .btn-home-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.18);
            color: #f0ebe4;
            text-decoration: none;
            font-size: 0.86rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }

        .btn-home-link:hover {
            background: rgba(255, 255, 255, 0.2);
            color: #ffffff;
            transform: translateX(-2px);
        }

        .brand-panel-body {
            position: relative;
            z-index: 2;
            max-width: 520px;
            margin: 40px 0;
        }

        .brand-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            border-radius: 999px;
            background: rgba(255, 90, 31, 0.2);
            border: 1px solid rgba(255, 90, 31, 0.35);
            color: #ff9a73;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            margin-bottom: 20px;
        }

        .brand-title {
            font-family: 'Fraunces', serif;
            font-size: clamp(2rem, 4vw, 3rem);
            font-weight: 600;
            line-height: 1.15;
            color: #ffffff;
            margin-bottom: 18px;
        }

        .brand-desc {
            color: #cfc6bc;
            font-size: 1rem;
            line-height: 1.7;
            margin-bottom: 30px;
        }

        .brand-panel-bottom {
            position: relative;
            z-index: 2;
            color: var(--theme-muted);
            font-size: 0.82rem;
        }

        /* ===== RIGHT FORM PANEL ===== */
        .form-panel {
            flex: 0.9;
            background: var(--theme-surface);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: clamp(32px, 5vw, 60px) clamp(24px, 4vw, 56px);
            position: relative;
        }

        .form-wrapper {
            width: 100%;
            max-width: 410px;
        }

        .form-header {
            margin-bottom: 28px;
        }

        .form-header h1 {
            font-family: 'Fraunces', serif;
            font-size: 2.2rem;
            font-weight: 600;
            color: var(--theme-ink);
            margin-bottom: 8px;
            line-height: 1.15;
        }

        .form-header p {
            color: var(--text-muted);
            font-size: 0.95rem;
            line-height: 1.5;
        }

        .validation-summary-errors {
            background: var(--theme-error-bg);
            border: 1px solid var(--theme-line);
            color: var(--theme-error);
            border-radius: 14px;
            padding: 12px 16px;
            font-size: 0.88rem;
            margin-bottom: 20px;
        }

        .validation-summary-errors ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        /* Form Controls */
        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            margin-bottom: 8px;
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--theme-ink);
        }

        .input-group {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-icon {
            position: absolute;
            left: 16px;
            color: var(--theme-muted);
            pointer-events: none;
            display: grid;
            place-items: center;
        }

        .input-icon svg {
            width: 19px;
            height: 19px;
        }

        .form-control {
            width: 100%;
            padding: 13px 16px 13px 46px;
            border-radius: 14px;
            border: 1.5px solid var(--border-color);
            background: var(--input-bg);
            color: var(--text-main);
            font-size: 0.95rem;
            font-family: inherit;
            outline: none;
            transition: all 0.2s ease;
        }

        .form-control:focus {
            background: var(--theme-surface);
            border-color: var(--brand-accent);
            box-shadow: 0 0 0 4px rgba(255, 90, 31, 0.12);
        }

        .form-control::placeholder {
            color: var(--theme-muted);
        }

        .input-group-password .form-control {
            padding-right: 48px;
        }

        .btn-toggle-password {
            position: absolute;
            right: 12px;
            background: none;
            border: none;
            color: var(--theme-muted);
            cursor: pointer;
            padding: 6px;
            border-radius: 8px;
            display: grid;
            place-items: center;
            transition: color 0.2s;
        }

        .btn-toggle-password:hover {
            color: var(--text-main);
        }

        .btn-toggle-password svg {
            width: 20px;
            height: 20px;
        }

        .field-error {
            display: block;
            margin-top: 6px;
            font-size: 0.82rem;
            color: var(--theme-error);
            font-weight: 500;
        }

        /* Submit Button */
        .btn-submit {
            width: 100%;
            padding: 14px 24px;
            border-radius: 999px;
            border: none;
            background: var(--theme-accent-bg);
            color: #ffffff;
            font-size: 1rem;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            transition: transform 0.2s, background-color 0.2s, box-shadow 0.2s;
            box-shadow: 0 8px 22px rgba(255, 90, 31, 0.32);
            margin-top: 10px;
        }

        .btn-submit:hover {
            background: var(--theme-accent-hover);
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(255, 90, 31, 0.42);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

        .form-footer {
            margin-top: 26px;
            text-align: center;
            font-size: 0.92rem;
        }

        .link-back-login {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--theme-muted);
            font-weight: 600;
            text-decoration: none;
            transition: color 0.15s;
        }

        .link-back-login:hover {
            color: var(--theme-accent);
        }

        /* Security info note */
        .security-note {
            margin-top: 24px;
            padding: 14px 16px;
            border-radius: 12px;
            background: var(--theme-raised);
            border: 1px solid #eae5df;
            font-size: 0.82rem;
            color: var(--theme-muted);
            line-height: 1.55;
        }

        /* ===== RESPONSIVE ===== */
        @@media (max-width: 900px) {
            .auth-container {
                flex-direction: column;
            }

            .brand-panel {
                flex: none;
                min-height: 240px;
                padding: 28px 24px;
            }

            .brand-panel-body {
                margin: 20px 0;
            }

            .brand-desc {
                display: none;
            }

            .form-panel {
                padding: 40px 24px;
            }
        }
    </style>
</head>
<body>
    <div class="auth-container">

        <!-- LEFT BRAND PANEL -->
        <div class="brand-panel">
            <div class="brand-panel-top">
                <a class="brand-logo" asp-controller="Home" asp-action="Index">
                    Custom<span class="accent-dot">.</span>Shop
                </a>
                <a class="btn-home-link" asp-controller="Home" asp-action="Index">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                    </svg>
                    กลับสู่หน้าร้าน
                </a>
            </div>

            <div class="brand-panel-bottom">
                &copy; 2569 CustomShop. All rights reserved.
            </div>
        </div>

        <!-- RIGHT FORM PANEL -->
        <div class="form-panel">
            <div class="form-wrapper">
                <div class="form-header">
                    <h1>ตั้งรหัสผ่านใหม่</h1>
                    <p>กรอกอีเมลบัญชีของคุณ และกำหนดรหัสผ่านใหม่เพื่อใช้งาน</p>
                </div>

                <form asp-controller="Account" asp-action="ForgotPassword" method="post" autocomplete="off">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

                    <!-- Registered Email -->
                    <div class="form-group">
                        <label class="form-label" asp-for="Email">อีเมลที่ลงทะเบียน (Registered Email)</label>
                        <div class="input-group">
                            <span class="input-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/>
                                </svg>
                            </span>
                            <input class="form-control" asp-for="Email" type="email" placeholder="example@customshop.com" required autocomplete="email" />
                        </div>
                        <span class="field-error" asp-validation-for="Email"></span>
                    </div>

                    <!-- New Password -->
                    <div class="form-group">
                        <label class="form-label" asp-for="NewPassword">รหัสผ่านใหม่ (อย่างน้อย 6 ตัวอักษร)</label>
                        <div class="input-group input-group-password">
                            <span class="input-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                                </svg>
                            </span>
                            <input id="newPasswordInput" class="form-control" asp-for="NewPassword" type="password" placeholder="••••••••" required />
                            <button type="button" class="btn-toggle-password" id="toggleNewPassBtn" aria-label="แสดงหรือซ่อนรหัสผ่าน">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                            </button>
                        </div>
                        <span class="field-error" asp-validation-for="NewPassword"></span>
                    </div>

                    <!-- Confirm Password -->
                    <div class="form-group">
                        <label class="form-label" asp-for="ConfirmPassword">ยืนยันรหัสผ่านใหม่</label>
                        <div class="input-group input-group-password">
                            <span class="input-icon">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                                </svg>
                            </span>
                            <input id="confirmPasswordInput" class="form-control" asp-for="ConfirmPassword" type="password" placeholder="••••••••" required />
                            <button type="button" class="btn-toggle-password" id="toggleConfirmPassBtn" aria-label="แสดงหรือซ่อนรหัสผ่าน">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                            </button>
                        </div>
                        <span class="field-error" asp-validation-for="ConfirmPassword"></span>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" class="btn-submit">
                        บันทึกรหัสผ่านใหม่
                    </button>

                    <div class="security-note">
                        💡 <strong>คำแนะนำ:</strong> เมื่อเปลี่ยนรหัสผ่านสำเร็จ ระบบจะนำคุณไปยังหน้าเข้าสู่ระบบทันทีเพื่อทดสอบรหัสผ่านใหม่
                    </div>

                    <!-- Back to Login -->
                    <div class="form-footer">
                        <a class="link-back-login" asp-controller="Account" asp-action="Login">
                            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                            </svg>
                            กลับสู่หน้าเข้าสู่ระบบ
                        </a>
                    </div>
                </form>

            </div>
        </div>

    </div>

    <script>
        function setupToggle(btnId, inputId) {
            var btn = document.getElementById(btnId);
            var input = document.getElementById(inputId);
            if (btn && input) {
                btn.addEventListener('click', function () {
                    var isPass = input.getAttribute('type') === 'password';
                    input.setAttribute('type', isPass ? 'text' : 'password');
                    btn.style.color = isPass ? 'var(--brand-accent)' : '#9c9186';
                });
            }
        }
        setupToggle('toggleNewPassBtn', 'newPasswordInput');
        setupToggle('toggleConfirmPassBtn', 'confirmPasswordInput');
    </script>
</body>
</html>
