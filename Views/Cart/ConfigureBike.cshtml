@model BikeBuildViewModel
@{
    ViewData["Title"] = "ปรับแต่ง " + Model.Bike.Name;
    var unavailable = Model.Slots.Any(group => group.Slot.MinQuantity > 0 && group.Options.Count == 0);
}
<section class="dash bike-builder">
    <header class="dash-header">
        <div><p class="dash-kicker">Custom Bike</p><h1>@Model.Bike.Name</h1>
            <p class="dash-subtitle">เลือกรายการอะไหล่เพื่อให้ Accounting จัดทำใบประเมินราคา</p></div>
        <a class="dash-button" asp-controller="Home" asp-action="CustomBike">กลับไปเลือกรุ่น</a>
    </header>

    @if (TempData["ErrorMessage"] is string error) { <p class="dash-notice is-error" role="alert">@error</p> }
    @if (unavailable) { <p class="dash-notice is-error" role="alert">อะไหล่จำเป็นบางรายการยังไม่มีตัวเลือกที่เปิดแสดง</p> }

    <section class="dash-panel bike-builder-summary" aria-labelledby="build-overview">
        <img src="@Url.Content("~/images/shop/" + Model.Bike.Image)" alt="@Model.Bike.Name" />
        <div><h2 id="build-overview">อะไหล่มาตรฐานและตัวเลือก</h2>
            <p class="dash-subtitle">@Model.Bike.Description</p>
            <p class="dash-subtitle">ราคาเริ่มต้น ฿@Model.Bike.Price.ToString("N2") · รายการที่มีป้ายจำเป็นต้องเลือกไว้</p>
        </div>
    </section>

    <form asp-controller="Cart" asp-action="ConfigureBike" method="post">
        <input asp-for="Form.BikeId" type="hidden" />
        <input asp-for="Form.RequestId" type="hidden" />
        <section class="dash-panel" aria-labelledby="build-parts">
            <header class="dash-panel-heading"><h2 id="build-parts">เลือกชุดอะไหล่</h2></header>
            @for (var index = 0; index < Model.Slots.Count; index++)
            {
                var group = Model.Slots[index];
                var chosen = group.Options.SingleOrDefault(option => option.StockItemId == Model.Form.Lines[index].StockItemId);
                <article class="bike-builder-row" data-build-row>
                    <div class="bike-builder-part">
                        <img class="bike-builder-part-image" data-part-image
                             src="@(chosen is null ? null : Url.Content("~/images/shop/" + chosen.Image))"
                             alt="@(chosen?.PartName ?? "")" loading="lazy" hidden="@(chosen is null)" />
                        <div><h3>@group.Slot.SlotName</h3>
                            <span class="dash-status @(group.Slot.MinQuantity > 0 ? "is-positive" : "")">@(group.Slot.MinQuantity > 0 ? "จำเป็น" : "เลือกเพิ่มได้")</span>
                            <p class="dash-subtitle" data-part-sku>@chosen?.Sku</p>
                        </div>
                    </div>
                    <input asp-for="Form.Lines[index].SlotCode" type="hidden" />
                    <details class="bike-builder-picker">
                        <summary>
                            <span class="bike-builder-selection">
                                <span class="bike-builder-selection-label">อะไหล่</span>
                                <strong data-part-summary>@(chosen?.PartName ?? (group.Slot.MinQuantity == 0 ? "ไม่เลือก" : "ไม่มีอะไหล่ให้เลือก"))</strong>
                                <span class="bike-builder-price" data-part-summary-price>@(chosen is null ? "" : $"฿{chosen.UnitPrice:N2}")</span>
                            </span>
                            <span class="bike-builder-chevron" aria-hidden="true"></span>
                        </summary>
                        <fieldset class="bike-builder-options">
                            <legend>เลือก@group.Slot.SlotName</legend>
                            @if (group.Slot.MinQuantity == 0)
                            {
                                <label class="bike-builder-option">
                                    <input asp-for="Form.Lines[index].StockItemId" type="radio" id="part-@(index)-none"
                                           value="" checked="@(chosen is null)" data-part-choice data-name="ไม่เลือก" />
                                    <span>ไม่เลือก</span>
                                </label>
                            }
                            @foreach (var option in group.Options)
                            {
                                <label class="bike-builder-option">
                                    <input asp-for="Form.Lines[index].StockItemId" type="radio" id="part-@(index)-@option.StockItemId"
                                           value="@option.StockItemId" required="@(group.Slot.MinQuantity > 0)"
                                           data-part-choice data-sku="@option.Sku" data-name="@option.PartName"
                                           data-price="฿@option.UnitPrice.ToString("N2")" data-image="@Url.Content("~/images/shop/" + option.Image)" />
                                    <span class="bike-builder-option-name">@option.PartName
                                        @if (!string.IsNullOrWhiteSpace(option.Variant))
                                        {
                                            <small>@option.Variant</small>
                                        }
                                    </span>
                                    <span class="bike-builder-price">฿@option.UnitPrice.ToString("N2")</span>
                                </label>
                            }
                        </fieldset>
                    </details>
                    <label class="dash-field">จำนวน
                        <input asp-for="Form.Lines[index].Quantity" data-part-quantity type="number" min="@group.Slot.MinQuantity"
                               max="@group.Slot.MaxQuantity" step="1" required />
                    </label>
                </article>
            }
        </section>
        <div class="dash-actions bike-builder-actions">
            <button class="dash-button is-primary" type="submit" disabled="@unavailable">ส่งคำขอประเมินราคา</button>
        </div>
    </form>
</section>

@section Scripts {
    <script src="~/js/bike-build.js" asp-append-version="true"></script>
}
