@model List<QuoteEstimateQueueRowViewModel>
@{
    ViewData["Title"] = "คิวประเมินราคา Custom Bike";
}
<section class="dash estimate-screen">
    <header class="dash-header">
        <h1>คิวประเมินราคา Custom Bike</h1>
        <a class="dash-button" asp-controller="Accounting" asp-action="Index">กลับ Dashboard</a>
    </header>
    <section class="dash-panel estimate-list" aria-label="รายการคิวประเมินราคา">
        @if (Model.Count == 0)
        {
            <p class="dash-empty mb-0">ยังไม่มีคำขอที่ต้องประเมิน</p>
        }
        else
        {
            <div class="estimate-list-heading d-none d-md-block px-3 px-lg-4 py-2" aria-hidden="true">
                <div class="row gx-3">
                    <div class="col-md-6">คำขอประเมินราคา</div>
                    <div class="col-md-3">สถานะ</div>
                    <div class="col-md-3 text-end">ดำเนินการ</div>
                </div>
            </div>
            <ul class="list-unstyled mb-0">
                @foreach (var row in Model)
                {
                    var project = row.Project;
                    <li class="estimate-list-item px-3 px-lg-4 py-3">
                        <div class="row gx-3 gy-2 align-items-center">
                            <div class="col-12 col-md-6">
                                <h2 class="text-break">@project.ProjectName</h2>
                                <p class="dash-subtitle small text-break">@project.CustomerName · @project.ProjectCode</p>
                            </div>
                            <div class="col-6 col-md-3">
                                <span class="visually-hidden">สถานะ </span><span class="dash-status text-wrap mw-100">@project.Status</span>
                            </div>
                            <div class="col-6 col-md-3 d-flex justify-content-end">
                                @if (QuoteWorkflow.CanEstimate(project))
                                {
                                    <a class="dash-button text-wrap text-center" asp-controller="Accounting" asp-action="Estimate" asp-route-id="@project.ProjectCode">เปิดใบประเมิน</a>
                                }
                                else if (row.LatestRevision is int revision)
                                {
                                    <a class="dash-button text-wrap text-center" asp-controller="Accounting" asp-action="EstimateDocument" asp-route-id="@project.ProjectCode" asp-route-revision="@revision">ดูใบประเมินที่ส่งแล้ว</a>
                                }
                            </div>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
</section>
