@model AdminCreateUserViewModel
@{
    Layout = "_LayoutUser";
    ViewData["Title"] = "เพิ่มผู้ใช้งานใหม่ - Admin";
}

<style>
    .admin-form-container {
        max-width: 680px;
        margin: 20px auto 60px;
    }

    .form-breadcrumb {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 24px;
        font-size: 0.9rem;
        color: var(--theme-muted);
    }

    .form-breadcrumb a {
        color: var(--theme-muted);
        text-decoration: none;
        transition: color 0.2s;
    }

    .form-breadcrumb a:hover {
        color: var(--theme-accent);
    }

    .form-breadcrumb span.separator {
        color: var(--theme-muted);
    }

    .admin-form-card {
        background: var(--theme-surface);
        border: 1px solid var(--theme-line);
        border-radius: 24px;
        padding: 36px;
        box-shadow: 0 10px 40px rgba(26, 26, 26, 0.06);
    }

    .form-header {
        margin-bottom: 28px;
        padding-bottom: 20px;
        border-bottom: 1px solid var(--theme-line);
    }

    .form-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 999px;
        background: rgba(255, 90, 31, 0.12);
        color: var(--theme-accent);
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .form-title {
        margin: 0;
        font-family: 'Fraunces', serif;
        font-size: 1.8rem;
        font-weight: 600;
        color: var(--theme-ink);
    }

    .form-subtitle {
        margin: 6px 0 0;
        font-size: 0.92rem;
        color: var(--theme-muted);
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group.full-width {
        grid-column: 1 / -1;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-size: 0.9rem;
        font-weight: 600;
        color: var(--theme-ink);
    }

    .form-group input, .form-group select {
        width: 100%;
        padding: 12px 16px;
        border: 1px solid var(--theme-control-border);
        border-radius: 12px;
        font-size: 0.95rem;
        color: var(--theme-ink);
        background: var(--theme-raised);
        transition: all 0.2s;
        box-sizing: border-box;
    }

    .form-group input:focus, .form-group select:focus {
        outline: none;
        border-color: var(--brand-accent);
        background: var(--theme-surface);
        box-shadow: 0 0 0 3px rgba(255, 90, 31, 0.15);
    }

    .validation-error {
        display: block;
        margin-top: 6px;
        font-size: 0.82rem;
        color: var(--theme-error);
        font-weight: 500;
    }

    .summary-errors {
        margin-bottom: 24px;
        padding: 14px 18px;
        border-radius: 12px;
        background: var(--theme-error-bg);
        border: 1px solid #fecaca;
        color: var(--theme-error);
        font-size: 0.9rem;
    }

    .summary-errors ul {
        margin: 0;
        padding-left: 20px;
    }

    .form-actions {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 30px;
        padding-top: 24px;
        border-top: 1px solid var(--theme-line);
    }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 13px 30px;
        border: none;
        border-radius: 999px;
        background: var(--theme-accent-bg);
        color: #ffffff;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        box-shadow: 0 6px 18px rgba(255, 90, 31, 0.25);
    }

    .btn-submit:hover {
        background: var(--theme-accent-hover);
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(255, 90, 31, 0.35);
    }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 13px 24px;
        border: 1px solid #d4cdc5;
        border-radius: 999px;
        background: var(--theme-surface);
        color: var(--theme-muted);
        font-size: 0.95rem;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s;
    }

    .btn-cancel:hover {
        border-color: var(--theme-ink);
        color: var(--theme-ink);
        background: var(--theme-raised);
    }

    @@media (max-width: 600px) {
        .form-grid {
            grid-template-columns: 1fr;
        }

        .admin-form-card {
            padding: 24px 20px;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn-submit, .btn-cancel {
            width: 100%;
        }
    }
</style>

<div class="admin-form-container">
    <div class="form-breadcrumb">
        <a asp-controller="Admin" asp-action="Index">Admin Dashboard</a>
        <span class="separator">/</span>
        <span>เพิ่มผู้ใช้งาน</span>
    </div>

    <div class="admin-form-card">
        <div class="form-header">
            <span class="form-badge">Create Account</span>
            <h1 class="form-title">เพิ่มผู้ใช้งานใหม่</h1>
            <p class="form-subtitle">กรอกข้อมูลผู้ใช้งานเพื่อลงทะเบียนเข้าสู่ระบบ CustomShop</p>
        </div>

        <form asp-controller="Admin" asp-action="CreateUser" method="post">
            <div asp-validation-summary="ModelOnly" class="summary-errors" role="alert"></div>

            <div class="form-grid">
                <div class="form-group full-width">
                    <label asp-for="Name">ชื่อ - นามสกุล</label>
                    <input asp-for="Name" placeholder="เช่น กฤษณะ ชัยเจริญ" autocomplete="name" />
                    <span asp-validation-for="Name" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Username">ชื่อผู้ใช้ (Username)</label>
                    <input asp-for="Username" placeholder="เช่น customshop_rider" autocomplete="username" />
                    <span asp-validation-for="Username" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="EmailUser">อีเมล (Email)</label>
                    <input asp-for="EmailUser" type="email" placeholder="example@email.com" autocomplete="email" />
                    <span asp-validation-for="EmailUser" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Tel">เบอร์โทรศัพท์</label>
                    <input asp-for="Tel" type="tel" placeholder="08x-xxx-xxxx" autocomplete="tel" />
                    <span asp-validation-for="Tel" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="RoleId">กำหนดสิทธิ์ (Role)</label>
                    <select asp-for="RoleId">
                        <option value="">Member (สมาชิกทั่วไป)</option>
                        @foreach (var role in Model.Roles)
                        {
                            <option value="@role.Id">@role.Name</option>
                        }
                    </select>
                    <span asp-validation-for="RoleId" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password">รหัสผ่าน</label>
                    <input asp-for="Password" type="password" placeholder="อย่างน้อย 8 ตัวอักษร" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword">ยืนยันรหัสผ่าน</label>
                    <input asp-for="ConfirmPassword" type="password" placeholder="กรอกรหัสผ่านซ้ำอีกครั้ง" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="validation-error"></span>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-submit">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    บันทึกข้อมูล
                </button>
                <a class="btn-cancel" asp-controller="Admin" asp-action="Index">ยกเลิก</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
