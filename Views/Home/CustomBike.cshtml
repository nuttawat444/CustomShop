@model CatalogPage
@{
    ViewData["Title"] = "Custom Bike Studio";
    Layout = "_LayoutUser";
}

<style>
    .custom-bike-page {
        width: min(var(--site-content-max), 100%);
        margin: 0 auto;
    }

    /* Hero Section */
    .custom-hero {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 280px;
        overflow: hidden;
        padding: clamp(32px, 6vw, 60px);
        border-radius: 28px;
        background:
            radial-gradient(circle at 85% 20%, rgba(255, 90, 31, 0.35), transparent 45%),
            linear-gradient(135deg, #171513 0%, #25211d 60%, #1f1c19 100%);
        color: #fff;
        margin-bottom: 36px;
        box-shadow: 0 20px 45px rgba(26, 26, 26, 0.12);
    }

    .custom-hero-eyebrow {
        margin: 0 0 10px;
        color: var(--brand-accent);
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }

    .custom-hero h1 {
        margin: 0;
        font-family: "Fraunces", Georgia, serif;
        font-size: clamp(2.2rem, 5vw, 3.8rem);
        font-weight: 700;
        line-height: 1.08;
    }

    .custom-hero-desc {
        max-width: 620px;
        margin: 14px 0 0;
        color: #d8cec4;
        font-size: 1.05rem;
        line-height: 1.65;
    }

    /* Filter Badges */
    .storefront-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 30px;
        align-items: center;
    }

    .filter-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 20px;
        border: 1px solid var(--theme-control-border);
        border-radius: 999px;
        background: var(--theme-surface);
        color: var(--theme-muted);
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
        user-select: none;
    }

    .filter-pill:hover {
        background: var(--theme-raised);
        color: var(--theme-ink);
        border-color: var(--theme-accent);
        transform: translateY(-1px);
    }

    .filter-pill.active {
        background: var(--theme-accent-bg);
        border-color: var(--theme-accent-bg);
        color: #fff;
        box-shadow: 0 4px 14px rgba(255, 90, 31, 0.35);
    }

    /* Grid Layout */
    .bike-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 24px;
    }

    /* Bike Card */
    .bike-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid var(--theme-line);
        border-radius: 22px;
        background: var(--theme-surface);
        box-shadow: 0 10px 28px rgba(26, 26, 26, 0.05);
        transition: transform 0.22s ease, box-shadow 0.22s ease;
    }

    .bike-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 40px rgba(26, 26, 26, 0.12);
    }

    /* Visual Image Container */
    .bike-visual {
        position: relative;
        display: block;
        height: 240px;
        overflow: hidden;
        background: #181614;
    }

    .bike-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
        transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .bike-card:hover .bike-img {
        transform: scale(1.08);
    }

    .bike-badge {
        position: absolute;
        top: 14px;
        left: 14px;
        z-index: 2;
        padding: 5px 12px;
        border-radius: 999px;
        background: rgba(20, 18, 15, 0.88);
        backdrop-filter: blur(6px);
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
    }

    .bike-badge.popular {
        background: var(--theme-accent-bg);
        color: #fff;
    }

    .bike-badge.sold {
        background: #6e655c;
        color: #fff;
    }

    .bike-body {
        display: flex;
        flex: 1;
        flex-direction: column;
        padding: 24px 22px 20px;
    }

    .bike-category {
        margin: 0 0 6px;
        color: var(--theme-accent);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .bike-name {
        margin: 0 0 10px;
        color: var(--theme-ink);
        font-family: "Fraunces", Georgia, serif;
        font-size: 1.45rem;
        font-weight: 600;
        line-height: 1.2;
    }

    .bike-desc {
        margin: 0 0 16px;
        color: var(--theme-muted);
        font-size: 0.92rem;
        line-height: 1.6;
        flex-grow: 1;
    }

    /* Specs List */
    .bike-specs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px 12px;
        margin: 0 0 20px;
        padding: 12px 14px;
        border-radius: 12px;
        background: var(--theme-raised);
        font-size: 0.82rem;
    }

    .bike-spec-item {
        display: flex;
        flex-direction: column;
    }

    .bike-spec-label {
        color: var(--theme-muted);
        font-size: 0.74rem;
        font-weight: 500;
    }

    .bike-spec-value {
        color: var(--theme-ink);
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Footer in Card */
    .bike-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 16px;
        border-top: 1px solid var(--theme-line);
        gap: 12px;
    }

    .bike-price-block {
        display: flex;
        flex-direction: column;
    }

    .bike-price-label {
        color: var(--theme-muted);
        font-size: 0.72rem;
        font-weight: 500;
        text-transform: uppercase;
    }

    .bike-price {
        color: var(--theme-ink);
        font-family: "Fraunces", Georgia, serif;
        font-size: 1.4rem;
        font-weight: 700;
        line-height: 1;
    }

    .btn-detail {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 18px;
        border: 1px solid var(--brand-accent);
        border-radius: 999px;
        background: var(--theme-accent-bg);
        color: #fff;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: background-color 0.18s ease, transform 0.18s ease;
        white-space: nowrap;
    }

    .btn-detail:hover {
        background: var(--brand-dark);
        border-color: var(--brand-dark);
        color: #fff;
        transform: translateY(-1px);
    }

    @@media (max-width: 992px) {
        .bike-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 640px) {
        .bike-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="custom-bike-page">

    <!-- Hero Header -->
    <section class="custom-hero">
        <p class="custom-hero-eyebrow">Custom Bike Studio · Handcrafted</p>
        <h1>Custom Bike Studio</h1>
        <p class="custom-hero-desc">
            รวมผลงานออกแบบและประกอบมอเตอร์ไซค์คัสตอมระดับพรีเมียม แต่ละคันถูกสร้างขึ้นตามความฝันและคาแรคเตอร์เฉพาะตัวของผู้ขับขี่ พร้อมสเปกและราคาประมาณการ
        </p>
    </section>

<div class="storefront-filters">
    <button type="button" class="filter-pill active" data-filter="all">ทั้งหมด (@Model.Items.Count คัน)</button>
    @foreach (var category in Model.Items.Select(x => x.Category).Distinct())
    { <button type="button" class="filter-pill" data-filter="@category">@category</button> }
</div>
<section class="bike-grid" id="bikeGrid">
@foreach (var bike in Model.Items)
{
    <article class="bike-card" data-style="@bike.Category">
        <div class="bike-visual"><img class="bike-img" src="@Url.Content("~/images/shop/" + bike.Image)" alt="@bike.Name" loading="lazy" /></div>
        <div class="bike-body"><p class="bike-category">@bike.Category</p><h2 class="bike-name">@bike.Name</h2>
            <p class="bike-desc">@bike.Description</p>
            <ul>@foreach (var spec in bike.Features.Split('\n', StringSplitOptions.RemoveEmptyEntries)){ <li>@spec</li> }</ul>
            
            <div class="bike-footer">
                <strong>ราคาเริ่มต้น ฿@bike.Price.ToString("N0")</strong>
                @if (ShopAccess.CanBuy(User) && Model.BuildableBikeIds.Contains(bike.Id))
                {
                    <a class="btn-detail" asp-controller="Cart" asp-action="ConfigureBike" asp-route-id="@bike.Id">เลือกอะไหล่และขอราคา</a>
                }
                else
                {
                    <partial name="_QuoteButton" model="bike" />
                }
            </div>
        </div>
    </article>
}
</section>
</div>

@section Scripts {
    <script>
        // Filter functionality for Custom Bikes
        document.querySelectorAll('.filter-pill').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
                this.classList.add('active');

                var filter = this.getAttribute('data-filter');
                var bikes = document.querySelectorAll('#bikeGrid .bike-card');

                bikes.forEach(function (bike) {
                    if (filter === 'all' || bike.getAttribute('data-style') === filter) {
                        bike.style.display = 'flex';
                    } else {
                        bike.style.display = 'none';
                    }
                });
            });
        });
    </script>
}
