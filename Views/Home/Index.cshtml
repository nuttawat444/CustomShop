@model HomePageViewModel
@{
    ViewData["Title"] = "CustomShop - ศูนย์รวมมอเตอร์ไซค์คัสตอมวินเทจ";
    Layout = "_LayoutUser";
}

<style>
    .shop-page {
        width: min(1200px, 100%);
        margin: 0 auto;
        padding-bottom: 60px;
    }

    /* ===== HERO SECTION ===== */
    .shop-hero {
        position: relative;
        display: flex;
        min-height: 480px;
        align-items: center;
        overflow: hidden;
        padding: clamp(40px, 8vw, 84px);
        border-radius: 28px;
        background:
            linear-gradient(90deg, rgba(16, 14, 12, 0.94) 0%, rgba(16, 14, 12, 0.82) 50%, rgba(16, 14, 12, 0.35) 100%),
            url("@Url.Content("~/images/shop/hero.jpg")") center 45% / cover no-repeat;
        color: #fff;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
    }

    .shop-hero-content {
        position: relative;
        z-index: 1;
        max-width: 600px;
    }

    .shop-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin: 0 0 16px;
        padding: 6px 14px;
        border-radius: 999px;
        background: rgba(255, 90, 31, 0.16);
        border: 1px solid rgba(255, 90, 31, 0.3);
        color: #ff9a73;
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .shop-hero h1 {
        margin: 0;
        font-family: "Fraunces", Georgia, serif;
        font-size: clamp(2.4rem, 5.5vw, 4.2rem);
        font-weight: 600;
        line-height: 1.08;
        color: #ffffff;
    }

    .shop-hero h1 span.accent-text {
        color: var(--brand-accent);
    }

    .shop-hero-copy {
        max-width: 490px;
        margin: 18px 0 28px;
        color: #e4ddd6;
        font-size: 1.05rem;
        line-height: 1.7;
    }

    .shop-hero-actions {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
    }

    .shop-cta-primary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 13px 26px;
        border-radius: 999px;
        background: var(--theme-accent-bg);
        color: #fff !important;
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: none;
        transition: transform 0.2s, box-shadow 0.2s, background-color 0.2s;
        box-shadow: 0 8px 24px rgba(255, 90, 31, 0.35);
    }

    .shop-cta-primary:hover {
        background: var(--theme-accent-hover);
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(255, 90, 31, 0.45);
    }

    .shop-cta-secondary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 13px 24px;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.25);
        color: #ffffff !important;
        font-weight: 500;
        font-size: 0.95rem;
        text-decoration: none;
        transition: all 0.2s;
    }

    .shop-cta-secondary:hover {
        background: rgba(255, 255, 255, 0.22);
        transform: translateY(-2px);
    }

    /* ===== SECTIONS COMMON ===== */
    .shop-section {
        padding: 60px 0 10px;
    }

    .section-header-wrap {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 28px;
        flex-wrap: wrap;
    }

    .section-title {
        margin: 0;
        font-family: "Fraunces", Georgia, serif;
        font-size: clamp(1.8rem, 3.8vw, 2.3rem);
        color: var(--theme-ink);
    }

    /* ===== BIKE STYLES SHOWCASE (4 CARDS) ===== */
    .styles-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
    }

    .style-card {
        border-radius: 20px;
        overflow: hidden;
        background: var(--theme-surface);
        border: 1px solid #eae5df;
        box-shadow: 0 10px 28px rgba(26, 26, 26, 0.05);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        display: flex;
        flex-direction: column;
    }

    .style-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 16px 36px rgba(26, 26, 26, 0.12);
    }

    .style-img-wrap {
        position: relative;
        height: 200px;
        overflow: hidden;
        background: #1a1a1a;
    }

    .style-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .style-card:hover .style-img-wrap img {
        transform: scale(1.08);
    }

    .style-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: rgba(18, 16, 14, 0.8);
        backdrop-filter: blur(6px);
        color: #ffffff;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border: 1px solid rgba(255, 255, 255, 0.15);
    }

    .style-body {
        padding: 20px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .style-title {
        margin: 0 0 8px;
        font-family: "Fraunces", Georgia, serif;
        font-size: 1.3rem;
        color: var(--theme-ink);
    }

    .style-desc {
        color: var(--theme-muted);
        font-size: 0.86rem;
        line-height: 1.6;
        margin: 0 0 16px;
        flex-grow: 1;
    }

    .style-footer {
        padding-top: 14px;
        border-top: 1px solid #f1ece6;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .style-price {
        font-size: 0.8rem;
        color: var(--theme-muted);
    }

    .style-price strong {
        display: block;
        font-size: 1.05rem;
        color: var(--brand-accent);
        font-family: 'Fraunces', serif;
    }

    .style-link {
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--theme-ink);
        display: inline-flex;
        align-items: center;
        gap: 4px;
        text-decoration: none;
        transition: color 0.2s;
    }

    .style-link:hover {
        color: var(--theme-accent);
    }

    /* ===== FEATURED PARTS (4 CARDS) ===== */
    .parts-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
    }

    .part-card {
        border-radius: 18px;
        overflow: hidden;
        background: var(--theme-surface);
        border: 1px solid #eae5df;
        box-shadow: 0 10px 24px rgba(26, 26, 26, 0.05);
        transition: transform 0.2s, box-shadow 0.2s;
        display: flex;
        flex-direction: column;
    }

    .part-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 32px rgba(26, 26, 26, 0.1);
    }

    .part-img-wrap {
        position: relative;
        height: 180px;
        overflow: hidden;
        background: #2a2825;
    }

    .part-img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.35s ease;
    }

    .part-card:hover .part-img-wrap img {
        transform: scale(1.06);
    }

    .part-tag {
        position: absolute;
        bottom: 10px;
        left: 10px;
        background: rgba(255, 255, 255, 0.92);
        color: #1a1a1a;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.05em;
    }

    .part-body {
        padding: 16px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .part-category {
        margin: 0 0 6px;
        color: var(--theme-muted);
        font-size: 0.74rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .part-title {
        margin: 0 0 6px;
        font-family: "Fraunces", Georgia, serif;
        font-size: 1.08rem;
        color: var(--theme-ink);
        line-height: 1.3;
    }

    .part-desc {
        color: var(--theme-muted);
        font-size: 0.82rem;
        line-height: 1.5;
        margin: 0 0 14px;
        flex-grow: 1;
    }

    .part-footer {
        padding-top: 12px;
        border-top: 1px solid #f1ece6;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .part-price strong {
        color: var(--brand-accent);
        font-size: 1.15rem;
        font-weight: 700;
    }

    .part-stock {
        font-size: 0.75rem;
        color: var(--theme-green);
        font-weight: 600;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 1024px) {
        .styles-grid,
        .parts-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 640px) {
        .styles-grid,
        .parts-grid {
            grid-template-columns: 1fr;
        }

        .shop-hero {
            padding: 30px 20px;
            border-radius: 20px;
        }
    }

    /* Dark Mode specific fine-tuning */







    /* ===== GUEST ALERT MODAL ===== */
    .guest-alert-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .guest-alert-modal.show {
        display: flex;
    }

    .guest-alert-overlay {
        position: absolute;
        inset: 0;
        background: rgba(0, 0, 0, 0.65);
        backdrop-filter: blur(4px);
    }

    .guest-alert-box {
        position: relative;
        z-index: 1;
        background: var(--theme-surface);
        border-radius: 24px;
        padding: 34px 28px;
        max-width: 430px;
        width: 100%;
        text-align: center;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
        border: 1px solid #eae5df;
        animation: guestModalPop 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @@keyframes guestModalPop {
        from { transform: scale(0.9); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    .guest-alert-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 16px;
        border-radius: 50%;
        background: rgba(255, 90, 31, 0.12);
        color: var(--brand-accent);
        display: grid;
        place-items: center;
        font-size: 2rem;
    }

    .guest-alert-box h3 {
        margin: 0 0 10px;
        font-family: 'Fraunces', serif;
        font-size: 1.45rem;
        color: var(--theme-ink);
    }

    .guest-alert-box p {
        margin: 0 0 24px;
        color: var(--theme-muted);
        font-size: 0.93rem;
        line-height: 1.6;
    }

    .guest-alert-actions {
        display: flex;
        gap: 12px;
    }

    .guest-btn-login {
        flex: 1;
        padding: 12px 20px;
        border-radius: 999px;
        background: var(--theme-accent-bg);
        color: #ffffff !important;
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: none;
        transition: background-color 0.2s, transform 0.2s;
        box-shadow: 0 4px 14px rgba(255, 90, 31, 0.3);
    }

    .guest-btn-login:hover {
        background: var(--theme-accent-hover);
        transform: translateY(-1px);
    }

    .guest-btn-cancel {
        flex: 1;
        padding: 12px 20px;
        border-radius: 999px;
        background: var(--theme-raised);
        border: none;
        color: var(--theme-muted);
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .guest-btn-cancel:hover {
        background: var(--theme-raised);
    }





</style>

<main class="shop-page">

    <!-- HERO SECTION -->
    <section class="shop-hero" aria-labelledby="shop-title">
        <div class="shop-hero-content">
            <div class="shop-eyebrow">
                <span>🏍️</span> CUSTOMSHOP · VINTAGE BIKE BUILDER
            </div>
            <h1 id="shop-title">
                รังสรรค์รถคัสตอม<br />
                <span class="accent-text">ในแบบที่เป็นคุณ</span>
            </h1>
            <p class="shop-hero-copy">
                สตูดิโอออกแบบ ดัดแปลง และสั่งประกอบมอเตอร์ไซค์คัสตอมระดับพรีเมียม ทั้ง Cafe Racer, Bobber, Scrambler และ Tracker ผสานความประณีตระดับงานศิลปะและสมรรถนะเพื่อการขับขี่จริง
            </p>
            <div class="shop-hero-actions">
                <a class="shop-cta-primary" asp-controller="Home" asp-action="CustomBike">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                    </svg>
                    ดูรถคัสตอมและขอประเมินราคา
                </a>
                <a class="shop-cta-secondary" asp-controller="Home" asp-action="Promotion">
                    ดูแพ็กเกจโปรโมชัน
                </a>
            </div>
        </div>
    </section>


    @foreach (var shelf in Model.Shelves)
    {
        <section class="shop-section" aria-labelledby="@shelf.Key">
            <h2 class="section-title mb-3" id="@shelf.Key">@shelf.Title</h2>
            <div class="styles-grid">
                @foreach (var item in shelf.Items)
                {
                    <article class="style-card">
                        <button type="button" class="style-img-wrap catalog-preview-image" data-bs-toggle="modal" data-bs-target="#catalog-preview"
                                data-catalog-preview="@item.Id" aria-haspopup="dialog" aria-label="ดูรายละเอียด @item.Name">
                            <img src="@Url.Content("~/images/shop/" + item.Image)" alt="" loading="lazy" />
                        </button>
                        <div class="style-body">
                            <h3>@item.Name</h3>
                            @if (!string.IsNullOrWhiteSpace(item.Description)) { <p>@item.Description</p> }
                            <button type="button" class="style-link catalog-preview-link" data-bs-toggle="modal" data-bs-target="#catalog-preview"
                                    data-catalog-preview="@item.Id" aria-haspopup="dialog">ดูรายละเอียด@(item.Price > 0 ? $" · ฿{item.Price:N2}" : "")</button>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</main>

<partial name="_CatalogPreview" model="Model.Shelves.SelectMany(shelf => shelf.Items)" />
